# Vercel CLI upload exclusions.
# Vercel builds the project in the cloud; these folders must not be uploaded.

# Build output (recreated by `npm run build` on Vercel)
/out/
/.next/
/build/
/dist/

# Dependencies (installed by Vercel from package-lock.json)
/node_modules/

# Local Vercel metadata and caches
/.vercel/
/.turbo/
/.cache/
/coverage/
/playwright-report/
/test-results/
*.tsbuildinfo
.eslintcache

# Local environment files and secrets (configure them in Vercel Project Settings)
.env*
!.env.example
!.env.template

# Logs and OS files
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db
