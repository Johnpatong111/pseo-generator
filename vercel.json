{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/api",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/api/products",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/compare/postgresql-vs-redis",
      "destination": "/en/category/databases",
      "statusCode": 301
    },
    {
      "source": "/en/compare/postgresql-vs-redis",
      "destination": "/en/category/databases",
      "statusCode": 301
    },
    {
      "source": "/pl/compare/postgresql-vs-redis",
      "destination": "/en/category/databases",
      "statusCode": 301
    },
    {
      "source": "/de/compare/postgresql-vs-redis",
      "destination": "/en/category/databases",
      "statusCode": 301
    },
    {
      "source": "/es/compare/postgresql-vs-redis",
      "destination": "/en/category/databases",
      "statusCode": 301
    },
    {
      "source": "/fr/compare/postgresql-vs-redis",
      "destination": "/en/category/databases",
      "statusCode": 301
    },
    {
      "source": "/compare/:slug",
      "destination": "/en/compare/:slug",
      "statusCode": 301
    },
    {
      "source": "/en/compare/express-vs-fastify",
      "destination": "/en/compare/fastify-vs-express",
      "statusCode": 301
    },
    {
      "source": "/en/compare/node-vs-bun",
      "destination": "/en/compare/bun-vs-node",
      "statusCode": 301
    },
    {
      "source": "/en/compare/nextjs-vs-astro",
      "destination": "/en/compare/astro-vs-nextjs",
      "statusCode": 301
    },
    {
      "source": "/share/:path*",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/de/compare/express-vs-fastify",
      "destination": "/en/compare/fastify-vs-express",
      "statusCode": 301
    },
    {
      "source": "/fr/compare/express-vs-fastify",
      "destination": "/en/compare/fastify-vs-express",
      "statusCode": 301
    },
    {
      "source": "/de/compare/node-vs-bun",
      "destination": "/en/compare/bun-vs-node",
      "statusCode": 301
    },
    {
      "source": "/fr/compare/node-vs-bun",
      "destination": "/en/compare/bun-vs-node",
      "statusCode": 301
    },
    {
      "source": "/de/compare/nextjs-vs-astro",
      "destination": "/en/compare/astro-vs-nextjs",
      "statusCode": 301
    },
    {
      "source": "/fr/compare/nextjs-vs-astro",
      "destination": "/en/compare/astro-vs-nextjs",
      "statusCode": 301
    },
    {
      "source": "/pl",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/pl/:path*",
      "destination": "/en/:path*",
      "statusCode": 301
    },
    {
      "source": "/de",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/de/:path*",
      "destination": "/en/:path*",
      "statusCode": 301
    },
    {
      "source": "/es",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/es/:path*",
      "destination": "/en/:path*",
      "statusCode": 301
    },
    {
      "source": "/fr",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/fr/:path*",
      "destination": "/en/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
